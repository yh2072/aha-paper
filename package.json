{
  "name": "aha-paper",
  "private": true,
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "icon": "python3 scripts/make-icon.py",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "34.2.0",
    "electron-builder": "25.1.8"
  },
  "allowScripts": {
    "electron@34.2.0": true
  },
  "version": "0.1.0",
  "description": "A guided read of a paper, narrated over the paper itself.",
