# Copy to .env and fill in. Values never leave this machine; .env is gitignored.
# Only the keys the code actually reads are listed.

# --- access: one shared password in front of the whole app ---
# Blank means no gate, which is the right default on 127.0.0.1. Set it before
# putting this on a public URL: every button in the studio spends your credits.
AHA_ACCESS_PASSWORD=

# Several people on one server, each bringing their own provider key.
# Off: one credential, one library, the operator's own — the local case.
# On: the login passphrase addresses a workspace. Same phrase, same workspace,
# on any device; a different phrase is a different workspace with its own
# credential store, its own papers and its own model choices. No accounts.
AHA_MULTI_TENANT=0

# --- provider connection (one account, shared by every use) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- which provider serves which use (names from Pi's registry) ---
LANGUAGE_PROVIDER=openrouter
# blank means: share the language provider
IMAGE_PROVIDER=

# --- models ---
OPENAI_MODEL=anthropic/claude-sonnet-5.5
OPENAI_MODEL_HUMANIZER=openai/gpt-5.6-sol-pro
OPENROUTER_MODEL_COVER=openai/gpt-image-2
OPENAI_MODEL_IMAGE=
OPENAI_MODEL_AUDIO=
IMAGE_PROTOCOL=openrouter-images

# --- narration ---
# Which service speaks: edge | openai | google | elevenlabs | minimax.
# edge needs no key. openai, google and minimax reuse the provider connection
# above (Pi's registry). elevenlabs has its own key: ELEVENLABS_API_KEY, or
# paste it in Models & voice. Providers without word timestamps are synthesized
# one sentence at a time, so the cursor moves per sentence instead of per clause.
TTS_PROVIDER=edge
# blank: the provider's default model / a voice that speaks the narration's language
TTS_MODEL=
TTS_VOICE=
ELEVENLABS_API_KEY=
# Edge keeps its own voice, so switching back to it restores the one you had.
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# The rate, for every provider (-50% to +50%).
EDGE_TTS_RATE=+0%

# --- cover typesetting (defaults to the bundled fonts/) ---
COVER_TITLE_FONT=
COVER_BODY_FONT=
